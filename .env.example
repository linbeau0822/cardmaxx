# Copy to .env and fill in real values. Never commit .env.

# Host port the docker-compose PostgreSQL binds to. If you already run
# PostgreSQL on 5432, set this to 5433 and update DATABASE_URL to match.
POSTGRES_PORT=5432

# PostgreSQL connection string.
# Matches the credentials in docker-compose.yml for local development.
DATABASE_URL=postgres://cardmaxx:cardmaxx@localhost:5432/cardmaxx?sslmode=disable

# Plaid credentials (https://dashboard.plaid.com/developers/keys).
# Use sandbox keys for local development.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# HTTP server
SERVER_PORT=8080

# Comma-separated list of origins allowed to call the API.
# Defaults to the Vite dev server when unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173
